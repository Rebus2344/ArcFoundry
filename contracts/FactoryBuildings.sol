                               
pragma solidity 0.8.30;
                                                                                                 
import {AdminAccess} from "./AdminAccess.sol";
contract FactoryBuildings is AdminAccess {
    constructor(address administrator) AdminAccess(administrator) {}
    function part(uint256 i) external pure returns(string memory result){
        require(i<56,"Invalid layer");
        bytes memory offsets=hex"0000025f047806eb098f0c240ed3109713fa166419b91b971d7b204d22b8247626c82a202d8c2fff332c356a370938e73b123cfb3fc0428244b444c144ce44d944e944f64500450c451a4523452e453d454d455845654573457f4587459545a245b145be45c945d745e545f145f946044610";
        bytes memory data=hex"";
        uint256 start;uint256 end;
        assembly("memory-safe"){start:=shr(240,mload(add(add(offsets,32),mul(i,2)))) end:=shr(240,mload(add(add(offsets,34),mul(i,2))))}
        result=new string(end-start);
        assembly("memory-safe"){let length:=sub(end,start) let src:=add(add(data,32),start) let dst:=add(result,32) for{let j:=0}lt(j,length){j:=add(j,32)}{mstore(add(dst,j),mload(add(src,j)))}}
    }
}
